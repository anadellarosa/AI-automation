    {
      "parameters": {
        "jsCode": "const ficha = $('Traer ficha desde Notion').first().json;\nconst kit = $('Traer kit de plantillas').first().json;\nconst props = $('Traer propiedades de la ficha').first().json.properties || {};\nconst clienteId = $('When Executed by Another Workflow').first().json.cliente_id;\n\nif (ficha.truncated || kit.truncated) {\n  throw new Error('Notion devolvió contenido truncado: revisar la página antes de generar');\n}\n\nconst sinEmails = (s) =>\n  String(s || '').replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g, '[email omitido]');\n\nconst aTexto = (p) => {\n  switch (p.type) {\n    case 'title': return p.title.map((t) => t.plain_text).join('');\n    case 'rich_text': return p.rich_text.map((t) => t.plain_text).join('');\n    case 'select': return p.select ? p.select.name : '';\n    case 'status': return p.status ? p.status.name : '';\n    case 'multi_select': return p.multi_select.map((o) => o.name).join(', ');\n    case 'url': return p.url || '';\n    case 'number': return p.number == null ? '' : String(p.number);\n    case 'date': return p.date ? p.date.start : '';\n    case 'checkbox': return p.checkbox ? 'sí' : 'no';\n    default: return ''; // email, teléfono, personas, relaciones: se descartan\n  }\n};\n\nconst lineas = [];\nfor (const [nombre, valor] of Object.entries(props)) {\n  if (/revisor/i.test(nombre)) continue;\n  const texto = aTexto(valor);\n  if (texto) lineas.push(`- ${nombre}: ${texto}`);\n}\n\nreturn [{\n  json: {\n    cliente_id: clienteId,\n    ficha: sinEmails(ficha.markdown),\n    propiedades: sinEmails(lineas.join('\\n')),\n    plantillas: sinEmails(kit.markdown),\n  },\n}];"
      },
